# Build output folders
**/[Bb]in/Debug/
**/[Bb]in/Release/
**/[Oo]bj/
artifacts/
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
.vscode/

# Ignore compiled binaries in bin root, but keep manifest and directory structure
bin/**/*.exe
bin/**/*.dll
bin/**/*.sys
bin/**/*.zip
bin/**/*.rar
bin/**/*.tar.gz
!bin/modules_manifest.json
!bin/**/.gitkeep

# Temporary and backup files
*.bak
*.tmp
*.log
*.swp

# Runtime generated user data
data/generated_*.json
data/profiles.json
