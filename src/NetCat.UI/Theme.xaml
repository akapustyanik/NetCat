  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
   <Border x:Name="card" CornerRadius="11" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="card" Property="Background" Value="{DynamicResource RaisedBrush}"/></Trigger>
    <DataTrigger Binding="{Binding Tag,RelativeSource={RelativeSource Self}}" Value="True"><Setter TargetName="card" Property="Background" Value="#2837B66A"/><Setter TargetName="card" Property="BorderBrush" Value="#369566"/></DataTrigger>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="card" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
