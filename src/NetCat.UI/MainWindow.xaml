<Window x:Class="NetCat.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NetCat.UI" Title="NetCat" Width="1120" Height="890" MinWidth="820" MinHeight="620" WindowStartupLocation="CenterScreen">
 <DockPanel>
  <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,9"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Отменить операцию" Click="Cancel_Click" IsEnabled="{Binding Busy}" Padding="10,3" MinHeight="25"/><Button Content="Остановить тест" Click="CancelTests_Click" IsEnabled="{Binding TestsBusy}" Padding="10,3" MinHeight="25"/></StackPanel><StackPanel><TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding TestStatus}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></DockPanel></Border>
  <Border DockPanel.Dock="Bottom" Padding="18,8" Background="{DynamicResource AccentSoftBrush}"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasUpdates}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><DockPanel><Button Content="Посмотреть обновления →" Click="ModulesPage_Click" DockPanel.Dock="Right" Padding="10,3" MinHeight="25"/><TextBlock Text="{Binding UpdateStatus}" VerticalAlignment="Center" FontSize="12"/></DockPanel></Border>
  <TabControl x:Name="Pages" Margin="0">
   <TabItem Header="Подключение"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="670" Margin="8,26,8,12">
    <Button Click="Vpn_Click" Width="112" Height="112" HorizontalAlignment="Center" Margin="0,0,0,14" ToolTip="{Binding VpnButton}" IsEnabled="{Binding Idle}"><Button.Style><Style TargetType="Button"><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ring" CornerRadius="60" BorderThickness="6" BorderBrush="{DynamicResource AccentSoftBrush}" Background="{TemplateBinding Background}"><StackPanel VerticalAlignment="Center"><Path Data="M 16 2 L 16 14 M 7.5 6 A 12 12 0 1 0 24.5 6" Stroke="{TemplateBinding Foreground}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="{Binding VpnButton}" FontSize="10" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ring" Property="Opacity" Value=".6"/></Trigger><DataTrigger Binding="{Binding VpnConnected}" Value="True"><Setter TargetName="ring" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></DataTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Button.Style></Button>
    <TextBlock Text="{Binding VpnStatus}" Style="{StaticResource Heading}" HorizontalAlignment="Center"/>
    <TextBlock Text="{Binding HealthDetails}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
    <DockPanel MaxWidth="510" Margin="0,0,0,6"><Button Content="＋ Импорт" Click="Import_Click" DockPanel.Dock="Right" Margin="10,0,0,0"/><ComboBox ItemsSource="{Binding VpnProfiles}" SelectedItem="{Binding MainProfile}" MinWidth="280" Margin="0"/></DockPanel>
    <TextBlock Text="{Binding ProfileDetails}" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,13"/>
    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,1" Padding="0,7" Margin="0,0,0,12"><DockPanel><ComboBox ItemsSource="{Binding ModeNames}" SelectedIndex="{Binding ModeIndex}" DockPanel.Dock="Right" Width="290" Margin="0"/><CheckBox Content="VPN / TUN" IsChecked="{Binding State.Tun}" VerticalAlignment="Center" ToolTip="Для всего компьютера. Без TUN приложения настраиваются на локальный прокси вручную."/></DockPanel></Border>
    <UniformGrid Columns="3" Margin="0,0,0,14"><StackPanel HorizontalAlignment="Center"><TextBlock Text="↓ Загрузка" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock x:Name="DownloadValue" Text="— Мбит/с" FontSize="21" Margin="0,3,0,0"/></StackPanel><StackPanel HorizontalAlignment="Center"><TextBlock Text="↑ Отдача" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock x:Name="UploadValue" Text="— Мбит/с" FontSize="21" Margin="0,3,0,0"/></StackPanel><StackPanel HorizontalAlignment="Center"><TextBlock Text="HTTP-пинг" ToolTip="Время HTTP-ответа через VPN после прогрева соединения. Это не ICMP-пинг до сервера." Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock x:Name="PingValue" Text="— мс" ToolTip="HTTP-задержка через подключённый VPN до адреса теста. Обновляется каждые 10 секунд." FontSize="21" Margin="0,3,0,0"/></StackPanel></UniformGrid>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Panel}" Padding="16" Margin="0,0,7,12"><StackPanel><DockPanel><ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding ZapretRunning,Mode=OneWay}" Click="ToggleZapret_Click" IsEnabled="{Binding Idle}" DockPanel.Dock="Right" ToolTip="Включить или выключить Zapret"/><TextBlock Text="Zapret" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{Binding ZapretStatus}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,8" TextTrimming="CharacterEllipsis"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="YouTube" FontSize="11"/><ComboBox ItemsSource="{Binding ServiceNames}" SelectedIndex="{Binding YouTubeIndex}" FontSize="12" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Discord" FontSize="11"/><ComboBox ItemsSource="{Binding ServiceNames}" SelectedIndex="{Binding DiscordIndex}" FontSize="12" Margin="0,4,0,0"/></StackPanel></Grid></StackPanel></Border>
     <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="16" Margin="7,0,0,12"><StackPanel><DockPanel><ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding TelegramRunning,Mode=OneWay}" Click="StartTelegram_Click" IsEnabled="{Binding Idle}" DockPanel.Dock="Right" ToolTip="Включить или выключить Telegram WS proxy"/><TextBlock Text="Telegram" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{Binding TelegramStatus}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,7,0,8"/><TextBlock Text="WS proxy · Flowseal" FontSize="12"/><Button Content="Подключить Telegram →" Click="OpenTelegram_Click" IsEnabled="{Binding TelegramRunning}" Padding="8,4" MinHeight="29" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel></Border>
    </Grid>
    <Border Style="{StaticResource Panel}" Padding="14" Margin="0,0,0,10"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="{Binding OpenVpnButton}" Click="OpenVpn_Click" FontSize="12" Padding="10,6" IsEnabled="{Binding Idle}"/><Button Content="Домены →" Click="RoutingPage_Click" Padding="10,6" FontSize="12" Margin="0"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="OpenVPN" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding OpenVpnProfiles}" SelectedItem="{Binding OpenVpnProfile}" IsEnabled="{Binding CanSelectOpenVpn}" FontSize="12" Margin="0,6,0,0" ToolTip="Профиль .ovpn можно добавить кнопкой Импорт"/></StackPanel></DockPanel></Border>
    <DockPanel><Button Content="Применить маршруты" Click="Apply_Click" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Margin="0"/><TextBlock Text="{Binding LocalEndpoint}" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></DockPanel>
    <TextBlock x:Name="TrafficText" Visibility="Collapsed"/><Canvas x:Name="TrafficCanvas" Height="0" Visibility="Collapsed"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Профили"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Профили" Style="{StaticResource Heading}"/><TextBlock Text="Подписки, серверы и OpenVPN. Выберите профиль для редактирования или теста." Style="{StaticResource Caption}"/></StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,6,0,15"><Button Content="＋ Импорт" Style="{StaticResource PrimaryButton}" Click="Import_Click"/><Button Content="Настроить" Click="EditProfile_Click"/><Button Content="Удалить" Click="DeleteProfile_Click"/><Button Content="Тест выбранного" Click="TestProfile_Click" IsEnabled="{Binding TestsIdle}"/><Button Content="Тест всех" Click="TestAll_Click" IsEnabled="{Binding TestsIdle}"/><Button Content="Подписки" Click="Subscriptions_Click"/></WrapPanel>
    <Grid Grid.Row="2">
     <ListBox x:Name="ProfilesGrid" Style="{StaticResource CardList}" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}">
      <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="125"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,18,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/><TextBlock Style="{StaticResource ListDetail}" Margin="0,6,0,0"><Run Text="{Binding Protocol}"/><Run Text="  ·  "/><Run Text="{Binding Core}"/></TextBlock></StackPanel>
       <TextBlock Grid.Column="1" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource ListDetail}"><Setter Property="Text" Value="Ручной выбор"/><Style.Triggers><DataTrigger Binding="{Binding Candidate}" Value="True"><Setter Property="Text" Value="↻ Автосмена"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       <StackPanel Grid.Column="2"><TextBlock Text="Последний HTTP-тест" Style="{StaticResource ListDetail}"/><TextBlock Text="{Binding Result}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Result}"/><Button Content="Подробности" Click="ProfileDetails_Click" HorizontalAlignment="Left" Padding="6,3" MinHeight="24" FontSize="11" Margin="0,6,0,0"/></StackPanel>
      </Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <Border VerticalAlignment="Top" Padding="24"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Panel}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Profiles.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="Добавьте первый профиль" FontWeight="SemiBold"/><TextBlock Text="Импортируйте подписку, ссылку на сервер или файл OpenVPN." Style="{StaticResource Caption}"/></StackPanel></Border>
    </Grid>
    <Border Grid.Row="3" Style="{StaticResource Panel}" Margin="0,18,0,0"><StackPanel><WrapPanel><CheckBox Content="Автотест профилей" IsChecked="{Binding State.AutoTest}"/><CheckBox Content="Автоматическая смена" IsChecked="{Binding State.AutoSwitch}"/><TextBlock Text="Интервал, с" VerticalAlignment="Center"/><TextBox Text="{Binding State.TestIntervalSeconds}" Width="65" Margin="8,0,16,0"/><TextBlock Text="Ошибок подряд" VerticalAlignment="Center"/><TextBox Text="{Binding State.FailureThreshold}" Width="50" Margin="8,0,0,0"/></WrapPanel><TextBlock Text="Автосмена: минимум две ошибки подряд, два успешных теста резервного профиля и пауза 2 минуты между переключениями. Скачок пинга сам по себе не вызывает смену. При выключенной автосмене профили не переключаются." Style="{StaticResource Caption}"/><Button Content="Сохранить настройки теста" Click="Save_Click" HorizontalAlignment="Left"/></StackPanel></Border>
   </Grid></TabItem>
   <TabItem Header="Маршрутизация"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="Маршрутизация" Style="{StaticResource Heading}"/><TextBlock Text="По правилам: VPN только для заданных маршрутов, остальное напрямую. Весь трафик: VPN по умолчанию, правила задают исключения. Первое совпадение побеждает. Ваши правила выше встроенных маршрутов сервисов и доменов OpenVPN." Style="{StaticResource Caption}"/>
    <Border Style="{StaticResource Panel}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="Общий режим"/><ComboBox ItemsSource="{Binding ModeNames}" SelectedIndex="{Binding ModeIndex}"/><TextBlock Text="Весь трафик: VPN по умолчанию, «Напрямую» — обход VPN. По правилам: напрямую по умолчанию. Zapret и Telegram proxy сохраняют свои маршруты в обоих режимах. Ваши явные правила имеют приоритет." Style="{StaticResource Caption}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Физический адаптер для прямого трафика"/><ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding State.PhysicalInterface}"/><TextBlock Text="Без выбора адаптер определяется автоматически до запуска TUN." Style="{StaticResource Caption}"/></StackPanel></Grid></Border>
    <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Встроенные правила сервисов · оба режима" FontWeight="SemiBold"/><TextBlock Text="{Binding Scenario}" Style="{StaticResource Caption}"/><TextBlock Text="Telegram: внешний SOCKS5, если выбран; иначе VPN или прямое подключение по галочке на вкладке «Модули». Если Zapret остановлен, выбранные для него сервисы идут напрямую. Ваше правило для приложения или домена имеет приоритет над этими настройками." Style="{StaticResource Caption}"/></StackPanel></Border>
    <WrapPanel Margin="0,0,0,12"><Button Content="＋ Правило" Style="{StaticResource PrimaryButton}" Click="AddRule_Click"/><Button Content="Добавить EXE" Click="ExeRule_Click"/><Button Content="Из запущенных" Click="RunningRule_Click"/><Button Content="Список доменов" Click="DomainList_Click"/><Button Content="Добавить стандартный пресет" Click="StandardPreset_Click" ToolTip="Добавить в конец списка: блокировка рекламы, RU-сайты напрямую. Существующие правила сохраняются."/><Button Content="Изменить" Click="EditRule_Click"/><Button Content="Удалить" Click="DeleteRule_Click"/><Button Content="↑" Click="UpRule_Click"/><Button Content="↓" Click="DownRule_Click"/></WrapPanel>
    <Border Style="{StaticResource Panel}" Padding="12" Margin="0" MinHeight="125"><Grid>
     <ListBox x:Name="RulesGrid" Style="{StaticResource CardList}" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" MaxHeight="280">
      <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
       <TextBlock Text="●" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Enabled}" Value="False"><Setter Property="Opacity" Value=".25"/><Setter Property="ToolTip" Value="Правило отключено"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       <StackPanel Grid.Column="1" Margin="0,0,15,0"><TextBlock Text="{Binding Value}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}"/><TextBlock Text="{Binding Kind,Converter={StaticResource RussianLabel}}" Style="{StaticResource ListDetail}" Margin="0,6,0,0"/></StackPanel>
       <Border Grid.Column="2" Style="{StaticResource Badge}" HorizontalAlignment="Left"><TextBlock Text="{Binding Target,Converter={StaticResource RussianLabel}}" FontSize="12"/></Border>
       <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Style="{StaticResource ListDetail}"><Run Text="Протокол: "/><Run Text="{Binding Network}"/></TextBlock><TextBlock Style="{StaticResource ListDetail}" Margin="0,4,0,0"><Run Text="Порт: "/><Run Text="{Binding Port}"/></TextBlock></StackPanel>
      </Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <StackPanel Margin="12" VerticalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Rules.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="Ваши правила маршрутизации" FontWeight="SemiBold"/><TextBlock Text="Добавьте домен или приложение и выберите, куда направлять его трафик." Style="{StaticResource Caption}"/></StackPanel>
    </Grid></Border>
    <Border Style="{StaticResource Panel}" Margin="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="Локальные / корпоративные домены через Wi-Fi" Style="{StaticResource Section}"/><TextBox Text="{Binding State.LocalDomains}" AcceptsReturn="True" Height="90"/><TextBlock Text="Имена разрешаются через DNS физического адаптера, без FakeIP и публичной подмены DNS." Style="{StaticResource Caption}"/><TextBlock Text="DNS прямого трафика (пусто = DNS адаптера)"/><TextBox Text="{Binding State.DirectDns}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Домены через OpenVPN" Style="{StaticResource Section}"/><TextBox Text="{Binding State.OpenVpnDomains}" AcceptsReturn="True" Height="90"/><TextBlock Text="Если OpenVPN отключён, эти домены блокируются, а не уходят через другой VPN или напрямую." Style="{StaticResource Caption}"/><TextBlock Text="DNS OpenVPN (пусто = переданный сервером)"/><TextBox Text="{Binding State.OpenVpnDns}"/></StackPanel></Grid></Border>
    <WrapPanel Margin="0,15,0,15"><Button Content="Применить правила" Click="Apply_Click" Style="{StaticResource PrimaryButton}"/><Button Content="Проверить маршрут" Click="ExplainRoute_Click"/><Button Content="Показать конфигурацию" Click="PreviewConfig_Click"/></WrapPanel>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Zapret"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Zapret" Style="{StaticResource Heading}"/><TextBlock Text="{Binding ZapretStatus}" Style="{StaticResource Caption}"/></StackPanel>
    <Border Grid.Row="1" Style="{StaticResource Panel}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,15,0"><TextBlock Text="YouTube"/><ComboBox ItemsSource="{Binding ServiceNames}" SelectedIndex="{Binding YouTubeIndex}"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,15,0"><TextBlock Text="Discord"/><ComboBox ItemsSource="{Binding ServiceNames}" SelectedIndex="{Binding DiscordIndex}"/></StackPanel><Button Grid.Column="2" Content="Применить сценарий" VerticalAlignment="Center" Click="Apply_Click"/></Grid></Border>
    <WrapPanel Grid.Row="2" Margin="0,0,0,14"><Button Content="Сделать активным" Click="MakeZapretActive_Click" IsEnabled="{Binding TestsIdle}"/><Button Content="Запустить выбранную" Style="{StaticResource PrimaryButton}" Click="StartZapret_Click" IsEnabled="{Binding TestsIdle}"/><Button Content="Остановить" Click="StopZapret_Click"/><Button Content="Тест выбранной" Click="TestZapret_Click" IsEnabled="{Binding TestsIdle}"/><Button Content="Автотест всех" Click="AutoZapret_Click" IsEnabled="{Binding TestsIdle}"/><Button Content="Прервать тест" Click="CancelTests_Click" IsEnabled="{Binding TestsBusy}"/></WrapPanel>
    <ListBox x:Name="ZapretGrid" Grid.Row="3" Style="{StaticResource CardList}" ItemsSource="{Binding Strategies}" SelectedItem="{Binding SelectedStrategy}">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource CardListItem}"><Setter Property="Tag" Value="{Binding Passed}"/></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><DockPanel><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="  ★ Активный" Foreground="{DynamicResource TextBrush}" FontSize="11" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPrimary}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="  ● Работает" Foreground="{DynamicResource AccentBrush}" FontSize="11" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DockPanel><TextBlock Text="Стратегия Flowseal" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/><Button Content="История проверок" Click="ZapretDetails_Click" HorizontalAlignment="Left" Padding="6,3" MinHeight="23" FontSize="11" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="YouTube" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock Text="{Binding YouTube}" Foreground="{DynamicResource TextBrush}" Margin="0,5,0,0" FontSize="12"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Discord" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock Text="{Binding Discord}" Foreground="{DynamicResource TextBrush}" Margin="0,5,0,0" FontSize="12"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="4" Margin="0,15,0,0"><CheckBox x:Name="AutoBestZapret" Content="После автотеста сделать лучший конфиг активным и запустить" IsChecked="{Binding State.ApplyBestZapret}"/><TextBlock Text="Тумблер на главной запускает конфиг с отметкой «Активный». Зелёный — пройдены все проверки выбранного сценария. Тесты проходят напрямую через физический адаптер. При отмене восстанавливается прежняя стратегия. HTTPS-тест не проверяет голос Discord и воспроизведение видео." Style="{StaticResource Caption}"/><TextBlock Text="{Binding Scenario}" Foreground="{DynamicResource AccentBrush}"/></StackPanel>
   </Grid></TabItem>
   <TabItem Header="Модули"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="Модули" Style="{StaticResource Heading}"/><TextBlock Text="Скачивание доступно через работающий VPN. Остановить компоненты нужно только перед установкой; повторное скачивание не потребуется." Style="{StaticResource Caption}"/>
    <Border Style="{StaticResource Panel}"><StackPanel><DockPanel><Button Content="Проверить обновления" Style="{StaticResource PrimaryButton}" Click="CheckModule_Click" IsEnabled="{Binding CanCheckUpdates}" DockPanel.Dock="Right" Margin="0"/><StackPanel><TextBlock Text="Центр обновлений" Style="{StaticResource Section}" Margin="0,0,0,5"/><TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Caption}"/></StackPanel></DockPanel><CheckBox Content="Проверять автоматически при запуске и каждые 6 часов" IsChecked="{Binding State.CheckModuleUpdates}" Click="Save_Click"/>
     <ListBox x:Name="ModulesGrid" Style="{StaticResource CardList}" ItemsSource="{Binding Modules}" SelectionMode="Single" Margin="0,12,0,0">
      <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition Width="0"/><ColumnDefinition Width="*"/><ColumnDefinition Width="135"/><ColumnDefinition Width="135"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
       <CheckBox IsChecked="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelectUpdate}" VerticalAlignment="Center" Margin="0" ToolTip="Выбрать обновление"/>

       <StackPanel Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Style="{StaticResource ListDetail}" Margin="0,4,0,0"/></StackPanel>
       <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="Установлен" Style="{StaticResource ListDetail}"/><TextBlock Text="{Binding Installed}" Margin="0,4,0,0" FontSize="12"/></StackPanel>
       <StackPanel Grid.Column="4" VerticalAlignment="Center"><TextBlock Text="Доступен" Style="{StaticResource ListDetail}"/><TextBlock Text="{Binding Latest}" Margin="0,4,0,0" FontSize="12"/></StackPanel>
       <Border Grid.Column="5" Style="{StaticResource Badge}" HorizontalAlignment="Right" MaxWidth="230"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12"/></Border>
      </Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <WrapPanel Margin="0,15,0,0"><Button Content="Скачать выбранные" Style="{StaticResource PrimaryButton}" Click="InstallModule_Click"/><Button Content="Установить скачанное" Click="InstallDownloaded_Click"/><Button Content="Откатить компонент" Click="RollbackModule_Click"/><Button Content="Закрепить / открепить версию" Click="PinModule_Click"/></WrapPanel><TextBlock Text="Проверка и скачивание не останавливают подключения. Установка использует проверенные локальные файлы и работает без интернета." Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Panel}"><StackPanel>
     <DockPanel><ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding TelegramRunning,Mode=OneWay}" Click="StartTelegram_Click" IsEnabled="{Binding Idle}" DockPanel.Dock="Right"/><TextBlock Text="Telegram · WS / MTProto-прокси" Style="{StaticResource Section}"/></DockPanel>
     <TextBlock Text="Встроенный прокси работает на этом компьютере. Его адрес всегда 127.0.0.1; порт ниже используется и в службе, и в ссылке для Telegram." Style="{StaticResource Caption}"/>
     <WrapPanel><StackPanel Margin="0,0,16,0"><TextBlock Text="Локальный адрес"/><TextBlock Text="127.0.0.1" Margin="0,12"/></StackPanel><StackPanel><TextBlock Text="Порт WS proxy"/><TextBox x:Name="TelegramWsPortInput" Text="{Binding State.TelegramWsPort,UpdateSourceTrigger=PropertyChanged}" Width="120"/></StackPanel><Button Content="Применить порт" Click="ApplyTelegramPort_Click" VerticalAlignment="Bottom"/></WrapPanel>
     <TextBlock Text="{Binding TelegramStatus}" Style="{StaticResource Caption}"/>
     <WrapPanel><Button Content="Подключить Telegram" Click="OpenTelegram_Click" IsEnabled="{Binding TelegramRunning}" Style="{StaticResource PrimaryButton}"/><Button Content="Скопировать ссылку" Click="TelegramLink_Click" IsEnabled="{Binding TelegramRunning}"/></WrapPanel>
     <TextBlock Text="{Binding TelegramRouteDescription}" Style="{StaticResource Caption}"/><CheckBox x:Name="TelegramVpnDefaultCheck" Content="Использовать VPN для Telegram по умолчанию, когда WS proxy выключен" IsChecked="{Binding TelegramVpnDefault}" IsEnabled="{Binding Idle}"/><TextBlock Text="Без галочки — напрямую. Выбор галочки отключает внешний SOCKS5. Ваши правила имеют приоритет. После остановки WS отключите локальный прокси также в настройках самого Telegram: NetCat не может изменить настройки Telegram за вас." Style="{StaticResource Caption}"/>
     <Expander Header="Внешний SOCKS5 · отдельный сервер" Margin="0,16,0,0" Foreground="{DynamicResource TextBrush}"><StackPanel Margin="0,12,0,0">
      <TextBlock Text="Эти настройки относятся к вашему внешнему SOCKS5-серверу, а не к встроенному WS proxy. Они определяют маршрут Telegram в обоих режимах. При недоступности сервера автоматического перехода на VPN нет." Style="{StaticResource Caption}"/>
      <CheckBox Content="Использовать внешний SOCKS5 вместо маршрута по умолчанию" IsChecked="{Binding TelegramSocks}"/>
      <Grid IsEnabled="{Binding TelegramSocks}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,15,0"><TextBlock Text="SOCKS5-сервер"/><TextBox Text="{Binding State.TelegramSocksHost}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Порт SOCKS5"/><TextBox Text="{Binding State.TelegramSocksPort}"/></StackPanel></Grid>
      <Button Content="Применить маршрут SOCKS5" Click="Apply_Click" HorizontalAlignment="Left"/>
     </StackPanel></Expander>
    </StackPanel></Border>
    <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="OpenVPN и Wintun" Style="{StaticResource Section}"/><TextBlock Text="OpenVPN и Wintun проверяются вместе с остальными модулями. Для совместимости используется ветка OpenVPN 2.6. Системная служба OpenVPN не требуется." Style="{StaticResource Caption}"/><Button Content="Открыть папку модулей" Click="OpenModules_Click" HorizontalAlignment="Left"/></StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Настройки"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="Настройки" Style="{StaticResource Heading}"/>
    <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Два цвета интерфейса" Style="{StaticResource Section}"/><TextBlock Text="Основной цвет определяет фон, панели и меню. Акцент определяет кнопки, вкладки, фокус, выделения и переключатели." Style="{StaticResource Caption}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="Основной цвет"/><Border Height="48" Background="{DynamicResource BaseBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Margin="0,8,0,12"/><Button Content="Выбрать основной цвет" Click="BaseColor_Click"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Акцентный цвет"/><Border Height="48" Background="{DynamicResource AccentBrush}" CornerRadius="8" Margin="0,8,0,12"/><Button Content="Выбрать акцент" Click="AccentColor_Click"/></StackPanel></Grid><WrapPanel Margin="0,15,0,0"><Button Content="Светлая основа" Click="Light_Click"/><Button Content="Тёмная основа" Click="Dark_Click"/></WrapPanel></StackPanel></Border>
    <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Поведение" Style="{StaticResource Section}"/><DockPanel Margin="0,6"><ToggleButton Style="{StaticResource Switch}" DockPanel.Dock="Right" IsChecked="{Binding State.MinimizeToTray}" Click="Save_Click"/><TextBlock Text="При закрытии сворачивать в трей" VerticalAlignment="Center"/></DockPanel><DockPanel Margin="0,10"><ToggleButton x:Name="AutostartSwitch" Style="{StaticResource Switch}" DockPanel.Dock="Right" Click="Autostart_Click"/><TextBlock Text="Запускать NetCat при входе в Windows" VerticalAlignment="Center"/></DockPanel><TextBlock x:Name="AutostartStatus" Text="Проверка автозапуска…" Style="{StaticResource Caption}"/><TextBlock Text="Адрес HTTP-теста" Margin="0,15,0,0"/><TextBox Text="{Binding State.TestUrl}"/><TextBlock Text="Таймаут, секунд"/><TextBox Text="{Binding State.TestTimeoutSeconds}" Width="100" HorizontalAlignment="Left"/><TextBlock Text="Локальный HTTP/SOCKS порт NetCat"/><TextBox Text="{Binding State.SocksPort}" Width="100" HorizontalAlignment="Left"/><Button Content="Сохранить" Click="Save_Click" HorizontalAlignment="Left"/></StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Журнал"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Диагностика" Style="{StaticResource Heading}"/><TextBlock Text="Сетевые состояния и результаты проверок. Ссылки с параметрами доступа и секреты скрываются." Style="{StaticResource Caption}"/><WrapPanel Margin="0,0,0,15"><Button Content="Проверить физический DNS" Click="NetworkInfo_Click"/><Button Content="Остановить все подключения" Click="StopAll_Click"/></WrapPanel></StackPanel><ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto"/></DockPanel></TabItem>
  </TabControl>
 </DockPanel>
</Window>
