<Window x:Class="NetCat.UI.Views.ConfigEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        mc:Ignorable="d"
        Title="Редактор конфигурации (JSON)" Height="600" Width="850"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="JSON Конфигурация" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusMessage" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </DockPanel>

        <Border Grid.Row="1" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Background="#121824">
            <avalonEdit:TextEditor x:Name="JsonEditor"
                                   FontFamily="Consolas"
                                   FontSize="13"
                                   ShowLineNumbers="True"
                                   Background="Transparent"
                                   Foreground="#E2E8F0"
                                   Padding="8"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Style="{DynamicResource FluentButton}" Width="100" Margin="0,0,10,0" Click="OnCancelClick"/>
            <Button Content="Сохранить" Style="{DynamicResource FluentPrimaryButton}" Width="110" Click="OnSaveClick"/>
        </StackPanel>
    </Grid>
</Window>
