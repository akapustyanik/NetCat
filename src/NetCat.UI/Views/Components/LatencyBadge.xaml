<UserControl x:Class="NetCat.UI.Views.Components.LatencyBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d">
    <Border x:Name="BadgeBorder" CornerRadius="10" Padding="8,3" Background="#1E293B" BorderThickness="1" BorderBrush="#334155">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="DotIndicator" Width="7" Height="7" Fill="#94A3B8" Margin="0,0,5,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="PingText" Text="-- ms" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>
