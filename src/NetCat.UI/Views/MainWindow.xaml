<Window x:Class="NetCat.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:components="clr-namespace:NetCat.UI.Views.Components"
        xmlns:viewModels="clr-namespace:NetCat.UI.ViewModels"
        mc:Ignorable="d"
        Title="NetCat" Height="680" Width="1020"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{DynamicResource WindowBackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" CornerRadius="12" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= SIDEBAR ================= -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" CornerRadius="12,0,0,12" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource CardBorderBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- App Logo & Title -->
                    <StackPanel Grid.Row="0" Margin="20,22,20,20" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="10" Background="#1E293B" Padding="4">
                            <Image Source="/assets/logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="NetCat" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="v0.5.0 • Native L3" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Navigation Items -->
                    <StackPanel Grid.Row="1" Margin="12,0,12,0">
                        <RadioButton Style="{DynamicResource NavButton}" Content="🏠  Панель управления" IsChecked="{Binding SelectedNavIndex, Converter={x:Static viewModels:NavIndexConverter.Instance}, ConverterParameter=0}"/>
                        <RadioButton Style="{DynamicResource NavButton}" Content="🌐  Профили / Узлы" IsChecked="{Binding SelectedNavIndex, Converter={x:Static viewModels:NavIndexConverter.Instance}, ConverterParameter=1}" Margin="0,4,0,0"/>
                        <RadioButton Style="{DynamicResource NavButton}" Content="🔀  Маршрутизация" IsChecked="{Binding SelectedNavIndex, Converter={x:Static viewModels:NavIndexConverter.Instance}, ConverterParameter=2}" Margin="0,4,0,0"/>
                        <RadioButton Style="{DynamicResource NavButton}" Content="⚡  DPI Bypass (Zapret)" IsChecked="{Binding SelectedNavIndex, Converter={x:Static viewModels:NavIndexConverter.Instance}, ConverterParameter=3}" Margin="0,4,0,0"/>
                        <RadioButton Style="{DynamicResource NavButton}" Content="✈️  Telegram WS-Proxy" IsChecked="{Binding SelectedNavIndex, Converter={x:Static viewModels:NavIndexConverter.Instance}, ConverterParameter=4}" Margin="0,4,0,0"/>
                        <RadioButton Style="{DynamicResource NavButton}" Content="📋  Диагностика и Логи" IsChecked="{Binding SelectedNavIndex, Converter={x:Static viewModels:NavIndexConverter.Instance}, ConverterParameter=5}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Settings Button in Sidebar Footer -->
                    <StackPanel Grid.Row="2" Margin="12,0,12,16">
                        <Separator Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,10"/>
                        <RadioButton Style="{DynamicResource NavButton}" Content="⚙️  Настройки" IsChecked="{Binding SelectedNavIndex, Converter={x:Static viewModels:NavIndexConverter.Instance}, ConverterParameter=6}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= MAIN CONTENT AREA ================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Window Bar (Draggable) -->
                <Grid Grid.Row="0" Background="Transparent" MouseDown="OnTitleBarMouseDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                        <TextBlock Text="NetCat Hybrid-VPN" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text=" • Wintun Driver &amp; WinDivert" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7"/>
                    </StackPanel>

                    <!-- Window Control Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Content="🗕" Width="38" Height="30" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Click="OnMinimizeClick" Cursor="Hand"/>
                        <Button Content="✕" Width="38" Height="30" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Click="OnCloseClick" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <!-- Content Panels based on SelectedNavIndex -->
                <Grid Grid.Row="1" Margin="24,10,24,24">

                    <!-- TAB 0: DASHBOARD (Windows 11 Fluent Concept 2) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding SelectedNavIndex, Converter={x:Static viewModels:NavVisibilityConverter.Instance}, ConverterParameter=0}">
                        <StackPanel>

                            <!-- Connection Status Card -->
                            <Border Style="{DynamicResource FluentCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Status Dot Indicator -->
                                    <Ellipse Grid.Column="0" Width="14" Height="14" Margin="4,0,16,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#64748B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <!-- Status Title and Subtitle -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding StatusSubtext}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Main Connect Switch -->
                                    <CheckBox Grid.Column="2" Style="{DynamicResource FluentToggleSwitch}"
                                              IsChecked="{Binding IsConnected, Mode=OneWay}"
                                              Command="{Binding ToggleConnectionCommand}"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Twin Realtime Traffic Graphs (Download & Upload) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Download Speed Card -->
                                <Border Grid.Column="0" Style="{DynamicResource FluentCard}" Height="165">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0">
                                            <TextBlock Text="↓ Входящий трафик (Download)" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding DownloadSpeedText}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentColorBrush}" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <components:TrafficGraph Grid.Row="1" Margin="0,8,0,0" DownloadSpeed="{Binding DownloadSpeed}"/>
                                    </Grid>
                                </Border>

                                <!-- Upload Speed Card -->
                                <Border Grid.Column="2" Style="{DynamicResource FluentCard}" Height="165">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0">
                                            <TextBlock Text="↑ Исходящий трафик (Upload)" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding UploadSpeedText}" FontSize="16" FontWeight="Bold" Foreground="#A855F7" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <components:TrafficGraph Grid.Row="1" Margin="0,8,0,0" UploadSpeed="{Binding UploadSpeed}"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Bottom Cards Grid: Server Profile & DPI / TG-Proxy Toggles -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Active Proxy Server Card -->
                                <Border Grid.Column="0" Style="{DynamicResource FluentCard}">
                                    <StackPanel>
                                        <TextBlock Text="Активный VPN Профиль" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <DockPanel Margin="0,10,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ActiveProfile.Name, FallbackValue='Профиль не выбран'}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding ActiveProfile.ServerAddress, FallbackValue='0.0.0.0'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <components:LatencyBadge HorizontalAlignment="Right" VerticalAlignment="Center" LatencyMs="{Binding ActivePing}"/>
                                        </DockPanel>
                                        <WrapPanel Margin="0,12,0,0">
                                            <Border CornerRadius="6" Background="#1E293B" Padding="8,3" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding ActiveProfile.Protocol, StringFormat='{}Протокол: {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <Border CornerRadius="6" Background="#1E293B" Padding="8,3">
                                                <TextBlock Text="{Binding CurrentRoutingMode, StringFormat='{}Режим: {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Quick Toggles (Zapret & Telegram Proxy) -->
                                <StackPanel Grid.Column="2">
                                    <Border Style="{DynamicResource FluentCard}" Padding="12">
                                        <DockPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="🛡️ Zapret DPI Bypass" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding ZapretStrategy, StringFormat='{}Стратегия: {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <CheckBox HorizontalAlignment="Right" Style="{DynamicResource FluentToggleSwitch}"
                                                      IsChecked="{Binding ZapretEnabled}" Command="{Binding ToggleZapretCommand}"/>
                                        </DockPanel>
                                    </Border>

                                    <Border Style="{DynamicResource FluentCard}" Padding="12">
                                        <DockPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="✈️ Telegram WS-Proxy" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="127.0.0.1:10852 • Flowseal" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <CheckBox HorizontalAlignment="Right" Style="{DynamicResource FluentToggleSwitch}"
                                                      IsChecked="{Binding TgProxyEnabled}" Command="{Binding ToggleTgProxyCommand}"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- TAB 1: PROFILES -->
                    <Grid Visibility="{Binding SelectedNavIndex, Converter={x:Static viewModels:NavVisibilityConverter.Instance}, ConverterParameter=1}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="Управление профилями VPN" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Проверить пинг всех" Style="{DynamicResource FluentButton}" Command="{Binding TestAllPingsCommand}" Margin="0,0,10,0"/>
                                <Button Content="+ Импорт из буфера" Style="{DynamicResource FluentPrimaryButton}" Command="{Binding ImportFromClipboardCommand}"/>
                            </StackPanel>
                        </DockPanel>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Profiles}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{DynamicResource FluentCard}" Margin="0,0,0,10">
                                        <DockPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <Border Margin="10,0,0,0" CornerRadius="6" Background="#06B6D4" Padding="6,2" Visibility="{Binding IsPrimary, Converter={x:Static viewModels:BoolToVisibilityConverter.Instance}}">
                                                        <TextBlock Text="ОСНОВНОЙ" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                    </Border>
                                                    <Border Margin="6,0,0,0" CornerRadius="6" Background="#A855F7" Padding="6,2" Visibility="{Binding IsBackup, Converter={x:Static viewModels:BoolToVisibilityConverter.Instance}}">
                                                        <TextBlock Text="РЕЗЕРВНЫЙ" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding ServerAddress}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <components:LatencyBadge LatencyMs="{Binding LastMetrics.TcpPingMs}" Margin="0,0,16,0"/>
                                                <Button Content="Сделать основным" Style="{DynamicResource FluentButton}" Margin="0,0,8,0"
                                                        Command="{Binding DataContext.SetPrimaryProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                <Button Content="Сделать резервом" Style="{DynamicResource FluentButton}" Margin="0,0,8,0"
                                                        Command="{Binding DataContext.SetBackupProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                <Button Content="Удалить" Style="{DynamicResource FluentButton}" Foreground="#EF4444"
                                                        Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- TAB 2: ROUTING RULES -->
                    <Grid Visibility="{Binding SelectedNavIndex, Converter={x:Static viewModels:NavVisibilityConverter.Instance}, ConverterParameter=2}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Правила маршрутизации трафика" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Direct, Proxy и Block маршруты для приложений, доменов и Geodata" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </DockPanel>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Rules}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{DynamicResource FluentCard}" Margin="0,0,0,8" Padding="12">
                                        <DockPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Description}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <Border Margin="8,0,0,0" CornerRadius="6" Background="#1E293B" Padding="6,2">
                                                        <TextBlock Text="{Binding Action}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentColorBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Target}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <CheckBox HorizontalAlignment="Right" Style="{DynamicResource FluentToggleSwitch}" IsChecked="{Binding Enabled}"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- TAB 3: ZAPRET DPI BYPASS -->
                    <ScrollViewer Visibility="{Binding SelectedNavIndex, Converter={x:Static viewModels:NavVisibilityConverter.Instance}, ConverterParameter=3}">
                        <StackPanel>
                            <TextBlock Text="Настройки Zapret (WinDivert L2/L3 DPI Bypass)" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Модуль обхода замедлений и блокировок Flowseal zapret-discord-youtube" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>

                            <Border Style="{DynamicResource FluentCard}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="Активировать Zapret Winws" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <CheckBox HorizontalAlignment="Right" Style="{DynamicResource FluentToggleSwitch}" IsChecked="{Binding ZapretEnabled}" Command="{Binding ToggleZapretCommand}"/>
                                    </DockPanel>
                                    <Separator Background="{DynamicResource CardBorderBrush}"/>
                                    <TextBlock Text="Стратегия десинхронизации (Strategy):" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <ComboBox SelectedValue="{Binding ZapretStrategy}" SelectedValuePath="Content" Width="240" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="ALT13"/>
                                        <ComboBoxItem Content="DISCORD"/>
                                        <ComboBoxItem Content="YOUTUBE"/>
                                        <ComboBoxItem Content="GENERAL"/>
                                    </ComboBox>
                                    <TextBlock Text="Кастомные аргументы командной строки winws (опционально):" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                                    <TextBox Text="{Binding Settings.Zapret.CustomArgs}" Background="#131924" Foreground="#E2E8F0" BorderBrush="{DynamicResource CardBorderBrush}" Padding="8" FontFamily="Consolas"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- TAB 4: TELEGRAM WS-PROXY -->
                    <ScrollViewer Visibility="{Binding SelectedNavIndex, Converter={x:Static viewModels:NavVisibilityConverter.Instance}, ConverterParameter=4}">
                        <StackPanel>
                            <TextBlock Text="Telegram WebSocket Proxy (Flowseal)" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Локальный прокси-сервер для прямого подключения Telegram без VPN" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>

                            <Border Style="{DynamicResource FluentCard}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="Включить Telegram WS Proxy" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <CheckBox HorizontalAlignment="Right" Style="{DynamicResource FluentToggleSwitch}" IsChecked="{Binding TgProxyEnabled}" Command="{Binding ToggleTgProxyCommand}"/>
                                    </DockPanel>
                                    <Separator Background="{DynamicResource CardBorderBrush}"/>
                                    <TextBlock Text="Локальный порт прокси (SOCKS5 / WS):" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBox Text="{Binding Settings.TgProxy.ListenPort}" Width="160" HorizontalAlignment="Left" Background="#131924" Foreground="#E2E8F0" BorderBrush="{DynamicResource CardBorderBrush}" Padding="8"/>
                                    <TextBlock Text="Настройка в Telegram: Настройки -> Продвинутые -> Тип соединения: SOCKS5 -> 127.0.0.1 : 10852" FontSize="12" Foreground="{DynamicResource AccentColorBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- TAB 5: DIAGNOSTICS & LOGS -->
                    <Grid Visibility="{Binding SelectedNavIndex, Converter={x:Static viewModels:NavVisibilityConverter.Instance}, ConverterParameter=5}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Диагностические логи и процессы" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Button Content="Очистить" Style="{DynamicResource FluentButton}" HorizontalAlignment="Right" Click="OnClearLogsClick"/>
                        </DockPanel>
                        <Border Grid.Row="1" CornerRadius="8" Background="#0C1017" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Padding="10">
                            <TextBox x:Name="LogsTextBox" Text="{Binding LogsText, Mode=OneWay}" IsReadOnly="True" Background="Transparent" Foreground="#94A3B8"
                                     FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0"/>
                        </Border>
                    </Grid>

                    <!-- TAB 6: SETTINGS -->
                    <ScrollViewer Visibility="{Binding SelectedNavIndex, Converter={x:Static viewModels:NavVisibilityConverter.Instance}, ConverterParameter=6}">
                        <StackPanel>
                            <TextBlock Text="Настройки приложения" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <Border Style="{DynamicResource FluentCard}">
                                <StackPanel>
                                    <TextBlock Text="Системная интеграция" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <CheckBox Content="Сворачивать в системный трей при закрытии" Style="{DynamicResource FluentToggleSwitch}" IsChecked="{Binding Settings.General.MinimizeToTrayOnClose}"/>
                                    <CheckBox Content="Автозапуск без UAC через планировщик Windows (Task Scheduler)" Style="{DynamicResource FluentToggleSwitch}" IsChecked="{Binding Settings.General.AutoStartWithWindows}" Click="OnAutoStartToggle"/>
                                    <Separator Background="{DynamicResource CardBorderBrush}"/>
                                    <TextBlock Text="Имя Wintun TUN интерфейса:" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBox Text="{Binding Settings.Network.TunInterfaceName}" Width="240" HorizontalAlignment="Left" Background="#131924" Foreground="#E2E8F0" BorderBrush="{DynamicResource CardBorderBrush}" Padding="8"/>
                                    <Button Content="Сохранить настройки" Style="{DynamicResource FluentPrimaryButton}" Width="180" HorizontalAlignment="Left" Click="OnSaveSettingsClick"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
